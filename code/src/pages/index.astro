---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import tokyAvatar from '../assets/toky.jpg';
---

<!doctype html>
<html lang="zh-Hant">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<Image class="avatar" src={tokyAvatar} width={160} height={160} alt="托奇" />
				<h1>一人 AI 工作室,把重複的事教給 AI 做</h1>
				<p>
					我是托奇,一人 AI 工作室。剪片、寫文件、做簡報這些事,我不是丟一句話問 AI
					就等答案,而是把整套流程教給它,讓它真的動手做完。這裡記錄我自己在用的 AI
					工作流,還有怎麼從完全不懂程式開始上手。
				</p>
			</section>
			<section class="cta">
				<a class="podcast-button" href="/blog">前往 Podcast</a>
				<a class="youtube-link" href="https://www.youtube.com/@Tokystory" target="_blank">
					YouTube 頻道 →
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 2em;
	}
	.avatar {
		display: block;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 1.5em;
	}
	.cta {
		text-align: center;
		padding: 2em 0;
	}
	.podcast-button {
		display: inline-block;
		padding: 0.9em 2.2em;
		background: var(--accent);
		color: white;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
	}
	.podcast-button:hover {
		background: var(--accent-dark);
		color: white;
	}
	.youtube-link {
		display: block;
		margin-top: 1em;
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.youtube-link:hover {
		color: var(--accent);
	}
</style>
